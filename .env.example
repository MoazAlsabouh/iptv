# ==============================================================
# تلفازي - ملف نموذج متغيرات البيئة (Telfazi Environment Variables Example)
# قم بنسخ هذا الملف إلى .env وتعبئة القيم المناسبة
# ==============================================================

# 1. رابط خادم الواجهة الخلفية (Backend API Base URL)
EXPO_PUBLIC_API_URL=https://iptv-backend.moaznsm.workers.dev

# 2. مفاتيح توقيع تطبيق أندرويد لنسخة الإنتاج (Release Keystore Signing)
# يمكن توفير هذه البيانات هنا أو داخل ملف frontend/android/keystore.properties
RELEASE_STORE_FILE=../@moaznstv__telfazi.jks
RELEASE_STORE_PASSWORD=your_keystore_password_here
RELEASE_KEY_ALIAS=your_key_alias_here
RELEASE_KEY_PASSWORD=your_key_password_here
